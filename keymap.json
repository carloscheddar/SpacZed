// Spacemacs / VSpaceCode-style keymap for Zed
//
// Inspired by https://github.com/wangfenjin/zed and VSpaceCode menus.
// Space is the leader in vim normal/visual; enable which_key in settings.json.
//
// Important: single-key prefixes like `space f` are null in the editor context so
// they stay pure prefixes (otherwise Zed times out ~1s and opens file finder).
// Do not use `!menu` on the main Spacemacs context — which-key can hide chords.
//
// Non-editor panes (Terminal/gitu, EmptyPane, Project/Git/Debug/Outline/MarkdownPreview
// panels) get the workspace-safe Space subset so SPC t z / SPC w / SPC g / etc. still work.
// AgentPanel is excluded so Space types normally in the thread message editor.
// Editor Spacemacs leader is normal/visual only — not insert (so Space inserts).

[
  {
    "context": "Editor && VimControl && !VimWaiting && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space": null,
      "space f": null,
      "space b": null,
      "space s": null,
      "space d": null,
      "space r": null,
      "space a": null,
      "space c": null,
      "space p": null,
      "space y": null,
      "space h": null,
      "space k": null,
      "space w d": "pane::CloseActiveItem",
      "space w q": null,

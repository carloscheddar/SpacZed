[
  {
    "label": "gitu",
    "command": "gitu",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
    "env": {
      "VISUAL": "zed",
      "EDITOR": "zed",
      "GIT_EDITOR": "zed --wait",
      "GITU_SHOW_EDITOR": "zed"
    }
  }
]
